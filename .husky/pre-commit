#!/bin/sh
# Fast checks on every commit. Slow checks (full build + Playwright e2e)
# run in .husky/pre-push so a commit takes seconds, and CI runs everything.
set -e

pnpm lint
pnpm --filter @tuvix.js/website lint
pnpm format:check
pnpm check-types
# `pnpm test` also runs check-package-exports, validate-docs and validate-i18n.
pnpm test
pnpm lint:md
