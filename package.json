{
  "name": "tuvix.js-monorepo",
  "private": true,
  "description": "Tuvix.js - A lightweight microfrontend framework",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test && pnpm test:scripts && tsx scripts/check-package-exports.ts && tsx scripts/check-adapter-contract.ts && tsx scripts/validate-code-examples.ts && tsx scripts/validate-i18n.ts",
    "test:scripts": "vitest run scripts/__tests__",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint --filter=./packages/*",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "check-types": "turbo run check-types",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check-links": "tsx scripts/check-links.ts",
    "check-package-exports": "tsx scripts/check-package-exports.ts",
    "check-adapter-contract": "tsx scripts/check-adapter-contract.ts",
    "validate-docs": "tsx scripts/validate-code-examples.ts",
    "validate-i18n": "tsx scripts/validate-i18n.ts",
    "lint:md": "markdownlint-cli2 \"**/*.md\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.15.0",
    "@github/markdownlint-github": "^0.8.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.6",
    "esbuild": "^0.28.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "jsdom": "22",
    "markdownlint-cli2": "^0.22.0",
    "prettier": "^3.4.1",
    "tsup": "^8.3.5",
    "tsx": "^4.21.0",
    "turbo": "^2.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.6"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18.0.0"
  }
}
