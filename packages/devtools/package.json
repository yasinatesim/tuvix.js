{
  "name": "@tuvix.js/devtools",
  "version": "0.4.2",
  "description": "In-page debug panel for Tuvix.js microfrontend framework",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "microfrontend",
    "devtools",
    "debug",
    "tuvix"
  ],
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {
    "@tuvix.js/event-bus": "workspace:^"
  }
}
