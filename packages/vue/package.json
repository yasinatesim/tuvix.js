{
  "name": "@tuvix.js/vue",
  "version": "0.5.0",
  "description": "Vue 3 bindings for Tuvix.js microfrontend framework",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "vue": ">=3.0.0",
    "@vue/server-renderer": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/server-renderer": {
      "optional": true
    }
  },
  "keywords": [
    "microfrontend",
    "vue",
    "tuvix"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yasinatesim/tuvix.js.git",
    "directory": "packages/vue"
  },
  "sideEffects": false,
  "devDependencies": {
    "@vue/server-renderer": "^3.0.0"
  },
  "dependencies": {
    "@tuvix.js/event-bus": "workspace:^",
    "@tuvix.js/loader": "workspace:^"
  }
}
