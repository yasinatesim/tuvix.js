{
  "name": "@tuvix.js/svelte",
  "version": "0.4.2",
  "description": "Svelte bindings for Tuvix.js microfrontend framework",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "svelte": ">=3.0.0 || >=4.0.0 || >=5.0.0"
  },
  "keywords": [
    "microfrontend",
    "svelte",
    "tuvix"
  ],
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {
    "@tuvix.js/loader": "workspace:^"
  },
  "devDependencies": {
    "svelte": "^5.53.0"
  }
}
