{
  "name": "@tuvix.js/loader",
  "version": "0.5.0",
  "description": "Dynamic module loader for Tuvix.js microfrontend framework",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yasinatesim/tuvix.js.git",
    "directory": "packages/loader"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
